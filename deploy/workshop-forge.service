[Unit]
Description=Workshop Forge Voice Assistant
Documentation=https://github.com/anthropics/workshop-forge
After=network-online.target sound.target
Wants=network-online.target
# Crash-loop protection: after 5 failures within 300s, stop restarting and
# enter `failed` instead of hammering the CPU re-loading the models forever.
StartLimitIntervalSec=300
StartLimitBurst=5
# Record a persistent note when the unit fails (e.g. after the crash-loop cap).
OnFailure=forge-notify@%n.service

[Service]
Type=simple
User=tyler
Group=tyler
WorkingDirectory=/home/tyler/projects/workshop-assistant
Environment=PATH=/home/tyler/projects/workshop-assistant/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONIOENCODING=utf-8
Environment=LANG=en_US.UTF-8
ExecStart=/home/tyler/projects/workshop-assistant/venv/bin/python src/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Audio permissions
SupplementaryGroups=audio

# Graceful shutdown
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target